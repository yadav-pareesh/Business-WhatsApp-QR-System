# Business WhatsApp QR SaaS Environment Configuration

# ==========================================
# SERVER ENVIRONMENT (server/.env)
# ==========================================

# Server Port
PORT=5000
NODE_ENV=development

# Database (PostgreSQL for production - required)
# Local dev: file:./dev.db (SQLite)
# Production: postgresql://user:password@host:5432/dbname?schema=public
DATABASE_URL="file:./dev.db"

# JWT Auth Secret (Use secure random key in production, min 32 characters)
JWT_SECRET="business_whatsapp_qr_secret_key_change_in_production_min_32_chars"

# App & Public URLs
APP_URL="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"

# CORS Origins (comma-separated for multiple origins)
CORS_ORIGIN="http://localhost:5173"

# Stripe Payments & Subscriptions (replace with live key in production)
STRIPE_SECRET_KEY=""

# ==========================================
# CLIENT ENVIRONMENT (set in Vercel dashboard)
# ==========================================

# API URL for the deployed backend (set this in Vercel client project settings)
# VITE_API_URL="https://your-server-project.vercel.app/api"
