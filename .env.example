# Business WhatsApp QR SaaS Environment Configuration

# Server Port
PORT=5000
NODE_ENV=development

# Database (Default: SQLite for local dev, PostgreSQL for production)
# SQLite: file:./dev.db
# PostgreSQL: postgresql://postgres:password@localhost:5432/whatsapp_qr?schema=public
DATABASE_URL="file:./dev.db"

# JWT Auth Secret (Use secure random key in production)
JWT_SECRET="business_whatsapp_qr_secret_key_change_in_production_min_32_chars"

# App & Public URLs
APP_URL="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"

# Optional Cloud Storage (e.g., S3 / Cloudinary for image uploads)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Stripe Payments & Subscriptions (replace with live key in production)
STRIPE_SECRET_KEY=""
